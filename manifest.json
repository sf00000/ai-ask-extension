{
  "manifest_version": 3,
  "name": "AI 划词提问助手",
  "version": "1.0.0",
  "description": "选中网页文字，右键一键向 ChatGPT、DeepSeek、Gemini、豆包等大模型提问。支持追加自定义提示词，每次自动开启新对话。",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://www.doubao.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*"
      ],
      "js": ["content/fill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
